<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/theme_background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="28dp">

            <ImageView
                android:id="@+id/movie_backdrop"
                android:layout_width="match_parent"
                android:layout_height="210dp"
                android:contentDescription="@string/detail_backdrop_description"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="20dp">

                <ImageView
                    android:id="@+id/movie_poster"
                    android:layout_width="120dp"
                    android:layout_height="180dp"
                    android:contentDescription="@string/detail_poster_description"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/movie_title"
                        style="@style/TextAppearance.JelajahRasa.Headline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/theme_text" />

                    <TextView
                        android:id="@+id/movie_tagline"
                        style="@style/TextAppearance.JelajahRasa.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/theme_text_secondary" />

                    <TextView
                        android:id="@+id/movie_rating"
                        style="@style/TextAppearance.JelajahRasa.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/theme_text" />

                    <TextView
                        android:id="@+id/movie_release_date"
                        style="@style/TextAppearance.JelajahRasa.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/theme_text_secondary" />

                    <TextView
                        android:id="@+id/movie_runtime"
                        style="@style/TextAppearance.JelajahRasa.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/theme_text_secondary" />

                    <TextView
                        android:id="@+id/movie_genres"
                        style="@style/TextAppearance.JelajahRasa.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/theme_primary"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                style="@style/TextAppearance.JelajahRasa.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="8dp"
                android:text="@string/detail_overview_title"
                android:textColor="@color/theme_text" />

            <TextView
                android:id="@+id/movie_overview"
                style="@style/TextAppearance.JelajahRasa.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="8dp"
                android:textColor="@color/theme_text_secondary"
                android:lineSpacingExtra="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/add_watchlist_button"
                    style="@style/Widget.JelajahRasa.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/collection_add_watchlist"
                    app:icon="@android:drawable/ic_menu_save" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/add_watched_button"
                    style="@style/Widget.JelajahRasa.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/collection_add_watched"
                    app:icon="@android:drawable/ic_menu_agenda"
                    app:iconTint="@color/theme_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/add_favorite_button"
                    style="@style/Widget.JelajahRasa.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/collection_add_favorite"
                    app:icon="@android:drawable/btn_star_big_off"
                    app:iconTint="@color/theme_primary" />

                <ProgressBar
                    android:id="@+id/detail_loading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="20dp"
                    android:indeterminateTint="@color/theme_primary"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/detail_error"
                    style="@style/TextAppearance.JelajahRasa.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:textColor="@color/soft_red"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/back_button"
        style="@style/Widget.Material3.Button.IconButton.Outlined"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/theme_surface"
        android:contentDescription="@string/action_back"
        app:icon="@drawable/ic_arrow_left"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconTint="@color/theme_text"
        app:cornerRadius="22dp"
        app:strokeColor="@color/theme_outline"
        app:strokeWidth="1dp"
        app:elevation="4dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
